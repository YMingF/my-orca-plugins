{
  "manifestVersion": 2,
  "id": "raw-markdown-copy",
  "name": "Raw Markdown Copy",
  "version": "0.2.0",
  "description": "Edit Markdown in Raw or Rich mode, preserving source formatting and copying the full current Markdown in one click.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "raw-markdown-copy",
        "title": "Raw + Copy",
        "extensions": [
          ".md",
          ".markdown",
          ".mdown",
          ".mkd",
          ".mkdn"
        ],
        "entry": "editor/index.html",
        "frame": "isolated"
      }
    ]
  }
}
